        "SNYK_TOKEN"
      ],
      "docsUrl": "https://docs.snyk.io/snyk-api-info/authentication-for-api",
      "managementUrl": "https://app.snyk.io/account"
    }
  ],
  "executables": [
    {
      "name": "Snyk CLI",
      "runs": [
        "snyk"
      ],
      "docsUrl": "https://docs.snyk.io/snyk-cli"
    }
  ]
}
