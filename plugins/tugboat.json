        "TUGBOAT_API_TOKEN"
      ],
      "docsUrl": "https://docs.tugboatqa.com/tugboat-cli/set-an-access-token/",
      "managementUrl": "https://dashboard.tugboatqa.com/access-tokens"
    }
  ],
  "executables": [
    {
      "name": "Tugboat CLI",
      "runs": [
        "tugboat"
      ],
      "docsUrl": "https://docs.tugboatqa.com/tugboat-cli/"
    }
  ]
}
