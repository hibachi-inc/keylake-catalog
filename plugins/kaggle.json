{
  "name": "kaggle",
  "serviceId": "kaggle",
  "category": "api",
  "keywords": [
    "kaggle"
  ],
  "platform": "Kaggle",
  "homepage": "https://kaggle.com",
  "credentials": [
    {
      "name": "APIToken",
      "length": 32,
      "charset": {
        "lowercase": true,
        "digits": true
      },
      "envVars": [
        "KAGGLE_KEY",
        "KAGGLE_USERNAME"
      ],
      "docsUrl": "https://www.kaggle.com/docs/api",
      "managementUrl": "https://www.kaggle.com/settings/account"
    }
  ],
  "executables": [
    {
      "name": "Kaggle CLI",
      "runs": [
        "kaggle"
      ],
      "docsUrl": "https://github.com/Kaggle/kaggle-api"
    }
  ]
}
