{
  "name": "sentry",
  "serviceId": "sentry",
  "category": "developer-service",
  "keywords": [
    "sentry"
  ],
  "platform": "Sentry",
  "homepage": "https://sentry.io",
  "credentials": [
    {
      "name": "AuthToken",
      "length": 64,
      "charset": {
        "lowercase": true,
        "digits": true
      },
      "envVars": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_URL"
      ],
      "docsUrl": "https://docs.sentry.io/api/auth/",
      "managementUrl": "https://sentry.io/settings/account/api/auth-tokens/"
    }
  ],
  "executables": [
    {
      "name": "Sentry CLI",
      "runs": [
        "sentry-cli"
      ],
      "docsUrl": "https://docs.sentry.io/product/cli/"
    }
  ]
}
