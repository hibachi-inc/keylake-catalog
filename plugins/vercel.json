{
  "name": "vercel",
  "serviceId": "vercel",
  "platform": "Vercel",
  "homepage": "https://vercel.com",
  "credentials": [
    {
      "name": "APIToken",
      "length": 24,
      "charset": {
        "uppercase": true,
        "lowercase": true,
        "digits": true
      },
      "docsUrl": "https://vercel.com/docs/rest-api#authentication",
      "managementUrl": "https://vercel.com/account/tokens"
    }
  ],
  "executables": [
    {
      "name": "Vercel CLI",
      "runs": [
        "vercel"
      ],
      "docsUrl": "https://vercel.com/docs/cli"
    }
  ]
}
