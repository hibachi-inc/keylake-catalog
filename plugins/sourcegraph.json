{
  "name": "sourcegraph",
  "platform": "Sourcegraph",
  "homepage": "https://sourcegraph.com",
  "credentials": [
    {
      "name": "AccessToken",
      "prefix": "https://",
      "charset": {
        "uppercase": true,
        "lowercase": true,
        "digits": true
      },
      "envVars": [
        "SRC_ACCESS_TOKEN",
        "SRC_ENDPOINT"
      ],
      "docsUrl": "https://sourcegraph.com/docs/cli",
      "managementUrl": "https://sourcegraph.com/settings/tokens"
    }
  ],
  "executables": [
    {
      "name": "Sourcegraph CLI",
      "runs": [
        "src"
      ],
      "docsUrl": "https://sourcegraph.com/docs/cli"
    }
  ]
}
