{
  "name": "snowflake",
  "platform": "Snowflake",
  "homepage": "https://snowflake.com",
  "credentials": [
    {
      "name": "LoginDetails",
      "charset": {
        "uppercase": true,
        "lowercase": true,
        "digits": true,
        "symbols": true
      },
      "envVars": [
        "SNOWSQL_ACCOUNT",
        "SNOWSQL_PWD",
        "SNOWSQL_USER"
      ],
      "docsUrl": "https://docs.snowflake.com/en/user-guide/admin-user-management.html#creating-users"
    }
  ],
  "executables": [
    {
      "name": "Snowflake CLI",
      "runs": [
        "snowsql"
      ],
      "docsUrl": "https://docs.snowflake.com/en/user-guide/snowsql.html"
    }
  ]
}
