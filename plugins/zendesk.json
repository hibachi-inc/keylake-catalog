{
  "name": "zendesk",
  "platform": "Zendesk",
  "homepage": "https://www.zendesk.com/",
  "credentials": [
    {
      "name": "APIToken",
      "length": 40,
      "charset": {
        "uppercase": true,
        "lowercase": true,
        "digits": true,
        "symbols": true
      },
      "envVars": [
        "ZENDESK_API_TOKEN",
        "ZENDESK_EMAIL",
        "ZENDESK_SUBDOMAIN"
      ],
      "docsUrl": "https://developer.zendesk.com/api-reference/introduction/security-and-auth/#api-token"
    }
  ],
  "executables": [
    {
      "name": "Zendesk CLI",
      "runs": [
        "zcli"
      ],
      "docsUrl": "https://developer.zendesk.com/documentation/apps/getting-started/using-zcli/"
    }
  ]
}
